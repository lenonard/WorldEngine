{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldengine.local/schema/v0.2.json",
  "title": "WorldEngine IR v0.2",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "version": { "type": "string" },
    "entryNode": { "type": "string" },
    "program": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "language": { "type": "string" },
        "entryPoint": { "type": "string" }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "execution": { "$ref": "#/$defs/execution" },
    "annotations": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "examples": ["start", "process", "decision", "subgraph", "external", "call", "return", "error", "end"]
        },
        "label": { "type": "string" },
        "summary": { "type": "string" },
        "parent": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "entryNode": { "type": "string" },
        "exitNodes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "defaultExpanded": { "type": "boolean" },
        "code": { "type": "string" },
        "source": { "$ref": "#/$defs/sourceRef" },
        "note": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "steps": { "type": "integer", "minimum": 0 },
            "branches": { "type": "integer", "minimum": 0 },
            "externalCalls": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "relation": { "type": "string" },
        "note": { "type": "string" },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "stackFrame": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "function": { "type": "string" },
            "file": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 },
            "node": { "type": "string" },
            "args": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": true
        }
      ]
    },
    "executionStep": {
      "type": "object",
      "properties": {
        "node": { "type": "string" },
        "edge": { "type": "string" },
        "event": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "message": { "type": "string" },
        "note": { "type": "string" },
        "variablesSnapshot": { "type": "boolean" },
        "variables": { "type": "object", "additionalProperties": true },
        "variablesRemoved": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "callStack": {
          "type": "array",
          "items": { "$ref": "#/$defs/stackFrame" }
        },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "required": ["trace"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/executionStep" }
        }
      },
      "additionalProperties": true
    }
  }
}
