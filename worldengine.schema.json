{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldengine.local/schema/v0.3.json",
  "title": "WorldEngine IR v0.3 Graph",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "version": { "type": "string" },
    "id": { "type": "string" },
    "type": {
      "type": "string",
      "examples": ["control-flow", "call-graph", "data-flow", "async-concurrency"]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "entryNode": { "type": "string" },
    "program": { "$ref": "#/$defs/program" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "execution": { "$ref": "#/$defs/execution" },
    "views": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/view" }
    },
    "annotations": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "metadata": { "$ref": "#/$defs/analysisMetadata" }
  },
  "additionalProperties": true,
  "$defs": {
    "program": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "language": { "type": "string" },
        "entryPoint": { "type": "string" },
        "repository": { "type": "string" },
        "revision": { "type": "string" }
      },
      "additionalProperties": true
    },
    "sourceRef": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string" }
      },
      "additionalProperties": true
    },
    "certainty": {
      "type": "string",
      "enum": ["observed", "inferred", "runtime", "possible", "unknown"]
    },
    "provenance": {
      "type": "string",
      "enum": ["source", "observed-runtime", "unit-test", "static-simulation", "user-provided", "partial"]
    },
    "analysisMetadata": {
      "type": "object",
      "properties": {
        "semanticId": { "type": "string", "minLength": 1 },
        "certainty": { "$ref": "#/$defs/certainty" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "symbol": { "type": "string" },
        "qualifiedName": { "type": "string" },
        "executionContext": { "type": "string" },
        "lane": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "callSite": { "$ref": "#/$defs/sourceRef" },
        "candidateTargets": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "synchronization": {
          "type": "object",
          "properties": {
            "kind": { "type": "string" },
            "resource": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "examples": ["start", "process", "decision", "subgraph", "group", "function", "data", "value", "async", "await", "task", "thread", "worker", "external", "call", "return", "error", "end"]
        },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "parent": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "entryNode": { "type": "string" },
        "exitNodes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "defaultExpanded": { "type": "boolean" },
        "code": { "type": "string" },
        "source": { "$ref": "#/$defs/sourceRef" },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceRef" }
        },
        "note": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "steps": { "type": "integer", "minimum": 0 },
            "branches": { "type": "integer", "minimum": 0 },
            "externalCalls": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "metadata": { "$ref": "#/$defs/analysisMetadata" }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "examples": ["control", "back", "loop", "call", "dynamic-call", "data-flow", "read", "write", "spawn", "await", "resume", "join", "message"]
        },
        "relation": {
          "type": "string",
          "examples": ["true", "false", "case", "default", "loop", "parameter", "return-value"]
        },
        "note": { "type": "string" },
        "metadata": { "$ref": "#/$defs/analysisMetadata" }
      },
      "additionalProperties": true
    },
    "stackFrame": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "function": { "type": "string" },
            "file": { "type": "string" },
            "line": { "type": "integer", "minimum": 1 },
            "node": { "type": "string" },
            "args": { "type": "object", "additionalProperties": true },
            "metadata": { "$ref": "#/$defs/analysisMetadata" }
          },
          "additionalProperties": true
        }
      ]
    },
    "executionStep": {
      "type": "object",
      "properties": {
        "node": { "type": "string" },
        "edge": { "type": "string" },
        "event": {
          "type": "string",
          "examples": ["enter", "process", "branch", "call", "return", "error", "await", "resume", "spawn", "join", "message", "read", "write"]
        },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "message": { "type": "string" },
        "note": { "type": "string" },
        "variablesSnapshot": { "type": "boolean" },
        "variables": { "type": "object", "additionalProperties": true },
        "variablesRemoved": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "callStack": {
          "type": "array",
          "items": { "$ref": "#/$defs/stackFrame" }
        },
        "metadata": { "$ref": "#/$defs/analysisMetadata" }
      },
      "additionalProperties": true
    },
    "scenario": {
      "type": "object",
      "required": ["trace"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "view": { "type": "string" },
        "inputs": { "type": "object", "additionalProperties": true },
        "trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/executionStep" }
        },
        "metadata": { "$ref": "#/$defs/analysisMetadata" }
      },
      "additionalProperties": true
    },
    "execution": {
      "type": "object",
      "oneOf": [
        {
          "required": ["trace"],
          "properties": {
            "id": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "view": { "type": "string" },
            "trace": {
              "type": "array",
              "items": { "$ref": "#/$defs/executionStep" }
            },
            "metadata": { "$ref": "#/$defs/analysisMetadata" }
          }
        },
        {
          "required": ["scenarios"],
          "properties": {
            "scenarios": {
              "type": "array",
              "items": { "$ref": "#/$defs/scenario" }
            },
            "metadata": { "$ref": "#/$defs/analysisMetadata" }
          }
        }
      ],
      "additionalProperties": true
    },
    "view": {
      "oneOf": [
        {
          "type": "object",
          "required": ["nodes", "edges"],
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "program": { "$ref": "#/$defs/program" },
            "entryNode": { "type": "string" },
            "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
            "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
            "metadata": { "$ref": "#/$defs/analysisMetadata" }
          },
          "additionalProperties": true
        },
        {
          "type": "object",
          "required": ["graph"],
          "properties": {
            "id": { "type": "string" },
            "type": { "type": "string" },
            "title": { "type": "string" },
            "description": { "type": "string" },
            "graph": {
              "type": "object",
              "required": ["nodes", "edges"],
              "properties": {
                "program": { "$ref": "#/$defs/program" },
                "entryNode": { "type": "string" },
                "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
                "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
                "metadata": { "$ref": "#/$defs/analysisMetadata" }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      ]
    }
  }
}
